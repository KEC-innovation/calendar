# Public browser configuration. Values are injected into the static Vite build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional. Leave unset for a root/custom-domain deployment. GitHub Actions
# automatically uses /<repository>/ when this value is absent.
VITE_BASE_PATH=

# Server-only secrets are configured in Supabase, never in this file:
# SUPABASE_SECRET_KEY, ALLOWED_ORIGINS, RATE_LIMIT_SALT,
# GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_PRIVATE_KEY, GOOGLE_CALENDAR_ENABLED,
# NOTIFICATION_PROVIDER_URL, NOTIFICATION_PROVIDER_TOKEN, CRON_SECRET.

# v2 server-only: APP_URL, BREVO_API_KEY (optional temporary-password emails), MAIL_FROM.
